rules_version = '2';
// 소담상회 올인원 앱 · Firestore 보안 규칙
// - 등록된 직원(staff/{Gmail})만 들어올 수 있어요. 원제님 계정은 처음부터 관리자예요.
// - DM은 대화에 들어 있는 두 사람만 읽고 쓸 수 있어요 (관리자도 못 봐요).
// - 안 읽음 기록(users/{uid}/reads)은 본인만 봐요.
// - 비공개 채널·프로젝트(priv: true)는 멤버(mem: Gmail 목록)만 메시지·할 일을 보고 써요. 관리자는 이름·멤버(설정)만 관리해요.
// - 공개 채널의 mem은 '들어간 사람' 목록이에요. 직원은 자기 자신만 넣고 빼요. 비공개 채널은 스스로 나가기만 돼요.
// - 공개 채널은 직원 누구나 만들어요. 비공개 채널·프로젝트는 관리자만 만들어요.
// - 그룹 DM(3~8명)도 대화에 든 사람만 읽고 써요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function em() { return request.auth.token.email.lower(); }
    function owner() { return signed() && em() == 'wonjea47@gmail.com'; }
    function staffPath() { return /databases/$(database)/documents/staff/$(em()); }
    function isStaff() { return owner() || (signed() && exists(staffPath()) && get(staffPath()).data.active != false); }
    function isAdmin() { return owner() || (isStaff() && get(staffPath()).data.admin == true); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function mine() { return request.resource.data.uid == request.auth.uid; }

    // 직원 명단: 누구나(직원) 보기 · 관리자만 고치기
    match /staff/{email} {
      allow read: if isStaff() || (signed() && email == em());
      allow write: if isAdmin();
    }

    // 활동을 남길 대화: 나와 받는 사람 모두 볼 수 있는 곳만
    function actTargetOk(uid, d) {
      let rem = get(/databases/$(database)/documents/users/$(uid)).data.email;
      return (d.k == 'c' && chOk(d.cid) && chSees(d.cid, rem))
        || (d.k == 'd' && request.auth.uid in get(/databases/$(database)/documents/dms/$(d.cid)).data.m
          && uid in get(/databases/$(database)/documents/dms/$(d.cid)).data.m);
    }
    function chSees(cid, e) {
      let c = get(/databases/$(database)/documents/channels/$(cid)).data;
      return c.get('priv', false) == false || e in c.get('mem', []);
    }
    // 남의 메시지에서 바꿀 수 있는 칸: 반응·답글 수·고정. 고정한 사람은 나로만 적어요
    function othersMsgOk() {
      return onlyKeys(['re', 'rc', 'lastReplyAt', 'ru', 'pinAt', 'pinBy'])
        && (request.resource.data.get('pinBy', null) == resource.data.get('pinBy', null)
          || request.resource.data.get('pinBy', null) in [null, request.auth.uid]);
    }

    // 프로필: 본인 것만 쓰기
    match /users/{uid} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.auth.uid == uid && request.resource.data.email == em();
      match /reads/{key} {
        allow read, write: if signed() && request.auth.uid == uid;
      }
      // 나중에 보기(저장): 본인만
      match /saved/{key} {
        allow read, write: if isStaff() && request.auth.uid == uid;
      }
      // 내 활동(멘션·반응·답글): 보낸 사람이 받는 사람 칸에 한 줄 남겨요. 읽기는 받는 사람만.
      // 남길 때: 보낸 사람 = 나, 받는 사람도 그 대화를 볼 수 있어야 해요 (비공개 내용이 새지 않게)
      match /act/{aid} {
        allow read, update: if isStaff() && request.auth.uid == uid;
        allow delete: if isStaff() && (request.auth.uid == uid || resource.data.from == request.auth.uid);
        allow create: if isStaff() && request.auth.uid != uid
          && request.resource.data.from == request.auth.uid
          && request.resource.data.keys().hasOnly(['t', 'from', 'k', 'cid', 'mid', 'rid', 'emo', 'text', 'at'])
          && request.resource.data.t in ['men', 're', 'rp']
          && request.resource.data.text is string && request.resource.data.text.size() <= 120
          && actTargetOk(uid, request.resource.data);
      }
    }

    // 채널·프로젝트: 만들기·설정·지우기는 관리자, 마지막 메시지 표시는 볼 수 있는 사람 누구나
    // 공개 채널은 priv == false, 비공개 채널·프로젝트는 priv == true + mem(멤버 Gmail 목록)
    function chOk(cid) {
      let c = get(/databases/$(database)/documents/channels/$(cid)).data;
      return isStaff() && (c.get('priv', false) == false || em() in c.get('mem', []));
    }
    match /channels/{cid} {
      // 목록(list) 검사에서 .get('priv', false) 는 조건 없는 전체 요청까지 통과시켜요 → priv == false 로 비교해요 (테스트로 확인)
      allow read: if isStaff() && (isAdmin() || resource.data.priv == false || em() in resource.data.mem);
      function memOld() { return resource.data.get('mem', []).toSet(); }
      function memNew() { return request.resource.data.get('mem', []).toSet(); }
      function selfOnly() { return [em()].toSet(); }
      // 들어가기: 공개 채널에 나만 더하기 · 나가기: 어느 채널이든 나만 빼기
      function joinOrLeave() {
        return isStaff() && onlyKeys(['mem'])
          && ((resource.data.get('priv', false) == false && memNew() == memOld().union(selfOnly()))
            || memNew() == memOld().difference(selfOnly()));
      }
      allow create: if isAdmin() || (isStaff()
        && request.resource.data.priv == false
        && !('kind' in request.resource.data)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.mem == [em()]);
      allow delete: if isAdmin();
      allow update: if isAdmin() || joinOrLeave() || (isStaff() && (resource.data.get('priv', false) == false || em() in resource.data.mem) && onlyKeys(['last', 'lastAt']));
      match /msgs/{mid} {
        allow read: if chOk(cid);
        allow create: if chOk(cid) && mine();
        allow update: if chOk(cid) && (resource.data.uid == request.auth.uid || othersMsgOk());
        allow delete: if chOk(cid) && (isAdmin() || resource.data.uid == request.auth.uid);
        match /replies/{rid} {
          allow read: if chOk(cid);
          allow create: if chOk(cid) && mine();
          allow update: if chOk(cid) && (resource.data.uid == request.auth.uid || onlyKeys(['re']));
          allow delete: if chOk(cid) && (isAdmin() || resource.data.uid == request.auth.uid);
        }
      }
      // 프로젝트 할 일: 멤버 누구나 만들고 고쳐요. 지우기는 만든 사람이나 관리자
      match /tasks/{tid} {
        allow read: if chOk(cid);
        allow create: if chOk(cid) && request.resource.data.by == request.auth.uid;
        allow update: if chOk(cid) && request.resource.data.by == resource.data.by;
        allow delete: if chOk(cid) && (isAdmin() || resource.data.by == request.auth.uid);
        match /cmts/{xid} {
          allow read: if chOk(cid);
          allow create: if chOk(cid) && mine();
          allow delete: if chOk(cid) && (isAdmin() || resource.data.uid == request.auth.uid);
        }
      }
    }

    // DM: 대화방 id = 두 사람 uid를 작은 순서로 '_'로 이은 것. 두 사람만 읽고 써요
    // 그룹 DM: id = 'g_' + 임의 글자, g: true, 멤버 3~8명(겹치지 않게). 멤버는 나중에 못 바꿔요
    match /dms/{did} {
      function dmMembers() { return get(/databases/$(database)/documents/dms/$(did)).data.m; }
      function inDm() { return isStaff() && request.auth.uid in dmMembers(); }
      allow get: if isStaff() && (resource == null || request.auth.uid in resource.data.m);
      allow list: if isStaff() && request.auth.uid in resource.data.m;
      allow create: if isStaff() && request.auth.uid in request.resource.data.m && (
        (request.resource.data.m.size() == 2
          && request.resource.data.m[0] < request.resource.data.m[1]
          && did == request.resource.data.m[0] + '_' + request.resource.data.m[1])
        || (request.resource.data.get('g', false) == true
          && request.resource.data.keys().hasOnly(['m', 'g', 'at'])
          && request.resource.data.m.size() >= 3
          && request.resource.data.m.size() <= 8
          && request.resource.data.m.toSet().size() == request.resource.data.m.size()
          && did.matches('g_[A-Za-z0-9]+')));
      allow update: if isStaff() && request.auth.uid in resource.data.m && onlyKeys(['last', 'lastAt']);
      match /msgs/{mid} {
        allow read: if inDm();
        allow create: if inDm() && mine();
        allow update: if inDm() && (resource.data.uid == request.auth.uid || othersMsgOk());
        allow delete: if inDm() && resource.data.uid == request.auth.uid;
        match /replies/{rid} {
          allow read: if inDm();
          allow create: if inDm() && mine();
          allow update: if inDm() && (resource.data.uid == request.auth.uid || onlyKeys(['re']));
          allow delete: if inDm() && resource.data.uid == request.auth.uid;
        }
      }
    }
  }
}
